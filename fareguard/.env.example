# --- Used by the Next.js app (set these in Vercel project settings, and
#     locally in .env.local) ---
TINYFISH_API_KEY=your_tinyfish_key_here
GROQ_API_KEY=your_groq_key_here
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Protects the POST trigger endpoints from random internet requests.
# Generate any random string. Vercel Cron sends this automatically once set.
CRON_SECRET=

# Lets the "Run sweep now" button on Vercel trigger the GitHub Actions
# workflow remotely (a PAT with `workflow` scope). Not needed locally.
GITHUB_TOKEN=
GITHUB_REPO=yourname/fareguard

# --- Used by the GitHub Actions workflow (set these as GitHub repo secrets,
#     Settings > Secrets and variables > Actions — NOT in this file) ---
# TINYFISH_API_KEY
# KV_REST_API_URL
# KV_REST_API_TOKEN
# GROQ_API_KEY
