# TinyFish — https://agent.tinyfish.ai/api-keys (Search + Fetch are free; Agent fallback is metered)
TINYFISH_API_KEY=
# Google Gemini — https://aistudio.google.com/apikey — analyzes papers and writes the manga script
GEMINI_API_KEY=
# Optional overrides
KENSHO_MODEL=gemini-3.8-flash
# Used in order when a model hits its daily free-tier quota
KENSHO_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# Set to "off" to never use the metered TinyFish Agent fallback
TINYFISH_AGENT_FALLBACK=on
