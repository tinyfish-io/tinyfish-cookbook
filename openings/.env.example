# Required: TinyFish Search, Fetch, Agent
TINYFISH_API_KEY=

# Optional: LLM extraction via Vercel AI Gateway (or run `vercel link && vercel env pull` for an OIDC token)
AI_GATEWAY_API_KEY=
# EXTRACT_MODEL=openai/gpt-4.1-mini

# Optional: Firecrawl fallback
FIRECRAWL_API_KEY=

# Production only: passcode that unlocks deep search (TinyFish Agent) on the public deploy
DEEP_SEARCH_PASSCODE=
