# TinyFish (required) — free key at https://agent.tinyfish.ai/
# docs-drift-radar only calls the Fetch endpoint, which is free for everyone.
TINYFISH_API_KEY=your-tinyfish-api-key

# Optional tuning
DOCS_DRIFT_DB=docs_drift_radar.db
DOCS_DRIFT_CONFIG=sources.yaml
DOCS_DRIFT_CONCURRENCY=5
DOCS_DRIFT_TIMEOUT_SECONDS=45
