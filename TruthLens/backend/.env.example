# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# Google Gemini API key. Used twice per analysis: once to plan the search queries and once to judge the evidence.
GEMINI_API_KEY=your_gemini_api_key_here
# TinyFish API key. Used to search the web and to fetch the text of the pages that were found.
TINYFISH_API_KEY=your_tinyfish_api_key_here

# -----------------------------------------------------------------------------
# OPTIONAL: Community Fact-Checks (MongoDB)
# Without MongoDB, claim analysis still works. Only the Community Fact-Checks
# page is disabled and shows an "unavailable" message.
# -----------------------------------------------------------------------------

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=truthlens

# Secret that signs anonymous visitor tokens for "I have seen this too".
# Set a long random value in production, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
# If empty, a random secret is generated once and stored in MongoDB.
# Changing it invalidates existing tokens.
VISITOR_TOKEN_SECRET=

# -----------------------------------------------------------------------------
# OPTIONAL: Telegram bot (create one with @BotFather)
# -----------------------------------------------------------------------------

# Token from @BotFather, e.g. 123456789:AAH... Keep it secret.
TELEGRAM_BOT_TOKEN=
# polling = works on your laptop, no public URL needed (default).
# webhook = for a deployed backend with a public HTTPS URL.
TELEGRAM_MODE=polling
# Only for webhook mode: a random string (letters, digits, _ and - only).
TELEGRAM_WEBHOOK_SECRET=

# Optional: only these Telegram user IDs (comma-separated) may use the bot.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_RATE_LIMIT_PER_HOUR=20
TELEGRAM_MAX_CONCURRENT_CHECKS=3