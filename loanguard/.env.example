# LoanGuard environment configuration.
# Copy this file to ".env" and fill in your values. Never commit the real .env.

# TinyFish API key — get one at https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# RBI starting page for Agent navigation. The Agent explores from here to
# Citizen's Corner -> "DLA's deployed by Regulated Entities" (the digital
# lending apps directory). The directory is dynamic (BI table / iframe),
# so this is the homepage, not a deep link.
RBI_DLA_URL=https://www.rbi.org.in/

# DEMO_MODE=1 replays saved sample events (no live API calls).
# DEMO_MODE=0 uses live TinyFish APIs.
DEMO_MODE=1

# Port for the Uvicorn server.
PORT=8000
